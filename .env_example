# =============================================================================
# PETBOOK — Variables de entorno
# =============================================================================
# Este archivo es una PLANTILLA pública. No contiene valores reales.
#
# Para configurar tu entorno local:
#   1. Copiá este archivo:  cp .env.example .env
#   2. Completá cada variable con los valores de tu entorno
#   3. Nunca subas el archivo .env al repositorio (ya está en .gitignore)
# =============================================================================


# =============================================================================
# APLICACIÓN
# =============================================================================

# Entorno de ejecución
# Valores posibles: development | production
APP_ENV=development

# Nombre de la aplicación
APP_NAME=Petbook

# URL base del proyecto en tu entorno local (sin barra final)
APP_URL=http://localhost/petbook/public

# Clave secreta para firmar sesiones y tokens
# Generá una con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=


# =============================================================================
# BASE DE DATOS
# =============================================================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=petbook
DB_USERNAME=root
DB_PASSWORD=


# =============================================================================
# SESIONES
# =============================================================================

# Tiempo de vida de la sesión en segundos
# 3600 = 1 hora | 86400 = 1 día
SESSION_LIFETIME=3600

# Nombre de la cookie de sesión
SESSION_NAME=petbook_session


# =============================================================================
# RECUPERACIÓN DE CONTRASEÑA
# =============================================================================

# Tiempo de expiración del token en minutos
TOKEN_EXPIRACION_MINUTOS=60


# =============================================================================
# EMAIL
# =============================================================================

# Para desarrollo local se recomienda Mailtrap (mailtrap.io)
# Crear cuenta gratuita y copiar las credenciales del inbox

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@petbook.com
MAIL_FROM_NAME=Petbook


# =============================================================================
# ALMACENAMIENTO DE IMÁGENES
# =============================================================================

# Tamaño máximo por imagen en bytes
# 2097152 = 2MB | 5242880 = 5MB
UPLOAD_MAX_SIZE=2097152

# Tipos MIME permitidos (separados por coma, sin espacios)
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
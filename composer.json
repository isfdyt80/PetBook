{
    "name": "petbook/petbook",
    "description": "Red social para mascotas — reporte de perdidos, encontrados y adopciones",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Instituto Superior de Formación Docente y Técnica N° 80 - 'Paulo Freire'",
            "email": "isfdyt80carloscasares@abc.gob.ar"
        }
    ],
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\":      "app/models/",
            "App\\Core\\":        "app/core/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test":  "./vendor/bin/phpunit --testdox",
        "lint":  "./vendor/bin/phpcs --standard=PSR12 app/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "vendor-dir": "vendor"
    },
    "minimum-stability": "stable"
}